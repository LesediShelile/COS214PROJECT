+#ifndef EVENTTYPE_H
+#define EVENTTYPE_H
+
+/** The kinds of event TIVIDY publishes. */
+enum class EventType {
+    ITEM_STATE_CHANGED,   ///< a Task moved to a new state
+    ITEM_COMPLETED,       ///< a Task reached Completed (EngineRouter reacts)
+    TASK_ACTION,          ///< an AuditedTask recorded an action
+    EXTERNAL_EVENT,       ///< something outside TIVIDY happened
+    TIMEOUT,              ///< a deadline passed
+    APPROVAL_ESCALATED,   ///< an approval moved up the chain
+    WORKFLOW_FINISHED     ///< a WorkflowInstance ended
+};
+
+#endif
