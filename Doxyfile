PROJECT_NAME           = "TIVIDY"
PROJECT_BRIEF          = "A Generic C++11 Workflow Management Engine"
PROJECT_NUMBER         = "COS214"

USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

OUTPUT_DIRECTORY       = docs/generated

INPUT                  = include \
                         src \
                         tests \
                         docs \
                         README.md

FILE_PATTERNS          = *.h \
                         *.hpp \
                         *.cpp \
                         *.dox \
                         *.md

RECURSIVE              = YES

EXCLUDE                = docs/generated \
                         html \
                         latex \
                         build \
                         tests/third_party \
                         stubs

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES

WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

GENERATE_HTML          = YES
HTML_OUTPUT            = html
GENERATE_TREEVIEW      = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO

HAVE_DOT               = YES
UML_LOOK               = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES

GENERATE_LATEX         = NO
GENERATE_XML           = NO